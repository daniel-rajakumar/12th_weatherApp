<?xml version="1.0" encoding="utf-8"?>
<MotionScene
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@id/start"
        motion:duration="1000">
        <OnSwipe motion:touchAnchorSide="bottom" />
    </Transition>

    <ConstraintSet android:id="@+id/start">

        <Constraint
            android:id="@+id/textView_weatherDescription"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintTop_toBottomOf="@id/textView_currentTemp"
            android:translationZ="10dp"
            motion:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="-8dp"
            android:visibility="visible" >

            <CustomAttribute motion:attributeName="textColor" motion:customColorValue="@color/font"/>
            <CustomAttribute motion:attributeName="textSize" motion:customFloatValue="30"/>
        </Constraint>
        <Constraint
            android:id="@+id/textView_currentTemp"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintTop_toBottomOf="@id/imageView_weatherIcon"
            android:translationZ="10dp"
            motion:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="-8dp"
            android:visibility="visible" >

            <CustomAttribute motion:attributeName="textSize" motion:customFloatValue="66"/>
        </Constraint>
    </ConstraintSet>


    <ConstraintSet android:id="@+id/end">

        <Constraint
            android:id="@+id/imageView_weatherIcon"
            android:layout_width="125dp"
            android:layout_height="125dp"
            motion:layout_constraintBottom_toTopOf="@+id/view_line"
            motion:layout_constraintTop_toBottomOf="@id/textView_lat_lon"
            motion:layout_constraintLeft_toLeftOf="parent"
            android:translationZ="10dp"
            android:layout_marginTop="16dp"
            android:layout_marginLeft="15dp"
            android:visibility="visible" />
        <Constraint
            android:id="@+id/textView_currentTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintTop_toBottomOf="@id/textView_tomorrow"
            motion:layout_constraintLeft_toLeftOf="@id/textView_tomorrow"
            android:translationZ="10dp"
            android:visibility="visible" >

            <CustomAttribute motion:attributeName="textSize" motion:customFloatValue="50"/>
        </Constraint>

        <Constraint
            android:id="@+id/textView_weatherDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:translationZ="10dp"
            motion:layout_constraintStart_toStartOf="@id/textView_currentTemp"
            motion:layout_constraintTop_toBottomOf="@id/textView_currentTemp"
            android:visibility="visible"
            >

            <CustomAttribute motion:attributeName="textColor" motion:customColorValue="@color/font_alt"/>
            <CustomAttribute motion:attributeName="textSize" motion:customFloatValue="20"/>
        </Constraint>


        <Constraint
            android:id="@+id/textView_tomorrow"
            motion:layout_constraintLeft_toRightOf="@id/imageView_weatherIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            motion:layout_constraintTop_toBottomOf="@id/textView_cityName"
            android:layout_marginStart="30dp"
            android:layout_marginTop="10dp"
            android:translationZ="10dp" />


        <Constraint
            android:id="@+id/editText_ZipCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintTop_toTopOf="parent"
            android:translationZ="10dp"
            motion:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="40dp"
            android:visibility="gone" />
        <Constraint
            android:id="@+id/button_search"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintBottom_toBottomOf="@+id/editText_ZipCode"
            motion:layout_constraintTop_toTopOf="@+id/editText_ZipCode"
            android:translationZ="10dp"
            android:visibility="gone" />
        <Constraint
            android:id="@+id/textView_lat_lon"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintBottom_toTopOf="@+id/imageView_weatherIcon"
            motion:layout_constraintTop_toBottomOf="@id/textView_cityName"
            android:translationZ="10dp"
            motion:layout_constraintStart_toStartOf="parent"
            android:visibility="gone" />
        <Constraint
            android:id="@+id/textView_currentDate"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintBottom_toTopOf="@+id/view_line"
            motion:layout_constraintTop_toBottomOf="@id/textView_weatherDescription"
            android:translationZ="10dp"
            motion:layout_constraintStart_toStartOf="parent"
            android:visibility="gone" />
        <Constraint
            android:id="@+id/listView_hourlyWeather"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintTop_toBottomOf="parent"
            android:translationZ="10dp"
            motion:layout_constraintStart_toStartOf="parent"
            android:visibility="visible" />
        <Constraint
            android:id="@+id/listView_dailyWeather"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            android:visibility="visible"
            motion:layout_constraintTop_toBottomOf="@+id/textView_today"
            android:translationZ="10dp"
            motion:layout_constraintStart_toStartOf="parent" />
        <Constraint
            android:id="@+id/textView_sevenDays"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintBottom_toBottomOf="@+id/textView_today"
            android:layout_marginBottom="5dp"
            motion:layout_constraintTop_toTopOf="@+id/textView_today"
            android:translationZ="10dp"
            android:visibility="invisible" />
        <Constraint
            android:id="@+id/textView_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintTop_toBottomOf="@+id/cardView"
            android:translationZ="10dp"
            motion:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp"
            android:visibility="gone" />
        <Constraint
            android:id="@+id/textView_cityName"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintBottom_toTopOf="@+id/textView_lat_lon"
            motion:layout_constraintTop_toTopOf="@+id/editText_ZipCode"
            android:translationZ="10dp"
            motion:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="40dp"
            android:visibility="visible" />

        <Constraint
            android:id="@+id/view_line"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            motion:layout_constraintTop_toBottomOf="@id/textView_currentDate"
            android:translationZ="10dp"
            android:layout_marginTop="32dp"
            android:layout_marginStart="35dp"
            android:layout_marginEnd="35dp"
            motion:layout_editor_absoluteX="35dp"
            android:visibility="visible" />
        <Constraint
            android:id="@+id/textView_tomorrowTempMin"
            motion:layout_constraintLeft_toRightOf="@id/textView_currentTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintBottom_toBottomOf="@+id/textView_currentTemp"
            android:visibility="visible"
            android:translationZ="10dp" />

    </ConstraintSet>
</MotionScene>