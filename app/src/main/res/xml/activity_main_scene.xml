<?xml version="1.0" encoding="utf-8"?>
<MotionScene
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@id/start"
        motion:duration="1000">
        <OnSwipe motion:touchAnchorSide="bottom" />
    </Transition>

    <ConstraintSet android:id="@+id/start">
    </ConstraintSet>


    <ConstraintSet android:id="@+id/end">

        <Constraint
            android:id="@+id/imageView_weatherIcon"
            android:layout_width="125dp"
            android:layout_height="125dp"
            motion:layout_constraintBottom_toTopOf="@+id/view_line"
            motion:layout_constraintTop_toBottomOf="@id/textView_lat_lon"
            motion:layout_constraintStart_toStartOf="parent"
            android:translationZ="10dp"
            android:layout_marginTop="16dp"
            android:visibility="visible" />
        <Constraint
            android:id="@+id/textView_currentTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintTop_toTopOf="@id/imageView_weatherIcon"
            motion:layout_constraintEnd_toEndOf="parent"
            android:translationZ="10dp"
            android:layout_marginTop="-8dp"
            android:visibility="visible" />
        <Constraint
            android:id="@+id/textView_weatherDescription"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:translationZ="10dp"
            motion:layout_constraintStart_toStartOf="@id/textView_currentTemp"
            motion:layout_constraintRight_toRightOf="@id/textView_currentTemp"
            motion:layout_constraintTop_toBottomOf="@id/textView_currentTemp"
            android:visibility="visible"
            android:layout_marginTop="-8dp"/>


        <Constraint
            android:id="@+id/editText_ZipCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintTop_toTopOf="parent"
            android:translationZ="10dp"
            motion:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="40dp"
            android:visibility="gone" />
        <Constraint
            android:id="@+id/button_search"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintBottom_toBottomOf="@+id/editText_ZipCode"
            motion:layout_constraintTop_toTopOf="@+id/editText_ZipCode"
            android:translationZ="10dp"
            android:visibility="gone" />
        <Constraint
            android:id="@+id/textView_lat_lon"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintBottom_toTopOf="@+id/imageView_weatherIcon"
            motion:layout_constraintTop_toBottomOf="@id/textView_cityName"
            android:translationZ="10dp"
            motion:layout_constraintStart_toStartOf="parent"
            android:visibility="gone" />
        <Constraint
            android:id="@+id/textView_currentDate"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            motion:layout_constraintBottom_toTopOf="@+id/view_line"
            motion:layout_constraintTop_toBottomOf="@id/textView_weatherDescription"
            android:translationZ="10dp"
            motion:layout_constraintStart_toStartOf="parent"
            android:visibility="gone" />
    </ConstraintSet>
</MotionScene>