<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/motionLayout"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:translationZ="10dp"
    app:layoutDescription="@xml/activity_main_scene"
    tools:context=".MainActivity"
    tools:visibility="visible">


    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="-8dp"
        app:cardBackgroundColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@+id/constraintLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="-75dp"
            app:cardBackgroundColor="@color/dark_blue"
            app:cardCornerRadius="75dp">

            <ImageView
                android:id="@+id/imageVIew_backgroundGif"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="TODO"
                android:scaleType="fitXY" />

        </androidx.cardview.widget.CardView>
    </androidx.cardview.widget.CardView>

    <EditText
        android:id="@+id/editText_ZipCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:ems="10"
        android:inputType="numberDecimal"
        android:text="60629"
        android:textColor="@color/font"
        android:translationZ="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null"
        android:backgroundTint="@color/dark_blue"
        android:text="Search"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/editText_ZipCode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/editText_ZipCode" />

    <TextView
        android:id="@+id/textView_cityName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:singleLine="true"
        android:text="New York"
        android:textAlignment="center"
        android:textColor="@color/font"
        android:textSize="30sp"
        android:translationZ="10dp"
        app:layout_constraintBottom_toTopOf="@+id/textView_lat_lon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/editText_ZipCode" />

    <TextView
        android:id="@+id/textView_lat_lon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="(lat, lon)"
        android:textColor="@color/font_alt"
        android:textSize="20sp"
        android:translationZ="10dp"
        app:layout_constraintBottom_toTopOf="@+id/imageView_weatherIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView_cityName" />

    <ImageView
        android:id="@+id/imageView_weatherIcon"
        android:layout_width="175dp"
        android:layout_height="175dp"
        android:layout_marginTop="16dp"
        android:contentDescription="TODO"
        android:src="@drawable/icon_rain"
        android:translationZ="10dp"
        app:layout_constraintBottom_toTopOf="@+id/textView_currentTemp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView_lat_lon" />

    <TextView
        android:id="@+id/textView_currentTemp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:text="-0.63°"
        android:textColor="@color/white"
        android:textSize="66sp"
        android:translationZ="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageView_weatherIcon" />

    <TextView
        android:id="@+id/textView_weatherDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:text="rain"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:translationZ="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView_currentTemp" />

    <TextView
        android:id="@+id/textView_currentDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monday, 17 May"
        android:textColor="@color/font_alt"
        android:textSize="20sp"
        android:translationZ="10dp"
        app:layout_constraintBottom_toTopOf="@+id/view_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView_weatherDescription" />

    <View
        android:id="@+id/view_line"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginHorizontal="35dp"
        android:layout_marginTop="32dp"
        android:background="@color/font_alt"
        android:translationZ="10dp"
        app:layout_constraintTop_toBottomOf="@id/textView_currentDate"
        tools:layout_editor_absoluteX="35dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:translationZ="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/cardView"
        app:layout_constraintTop_toBottomOf="@id/view_line">


        <ImageView
            android:id="@+id/imageView_currentWind"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="TODO"
            android:scaleType="fitXY"
            android:src="@mipmap/icon_wind_foreground"
            app:layout_constraintBottom_toBottomOf="@+id/imageView_currentHumidity"
            app:layout_constraintEnd_toEndOf="@+id/textView_currentWindSpeed_1"
            app:layout_constraintStart_toStartOf="@+id/textView_currentWindSpeed_1"
            app:layout_constraintTop_toTopOf="@+id/imageView_currentHumidity" />

        <TextView
            android:id="@+id/textView_currentWindSpeed_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="13 km/h"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:translationZ="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/textView_currentHumidity_1"
            app:layout_constraintEnd_toStartOf="@+id/textView_currentHumidity_1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textView_currentHumidity_1" />

        <TextView
            android:id="@+id/textView_currentWindSpeed_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Wind"
            android:textColor="@color/font_alt"
            android:textSize="15sp"
            android:translationZ="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/textView_currentHumidity_2"
            app:layout_constraintEnd_toEndOf="@+id/textView_currentWindSpeed_1"
            app:layout_constraintStart_toStartOf="@+id/textView_currentWindSpeed_1"
            app:layout_constraintTop_toTopOf="@+id/textView_currentHumidity_2" />

        <ImageView
            android:id="@+id/imageView_currentHumidity"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="TODO"
            android:scaleType="fitXY"
            android:src="@mipmap/icon_humidity_foreground"
            app:layout_constraintEnd_toEndOf="@+id/textView_currentHumidity_1"
            app:layout_constraintStart_toStartOf="@+id/textView_currentHumidity_1"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView_currentHumidity_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="24%"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:translationZ="20dp"
            app:layout_constraintBottom_toTopOf="@+id/textView_currentHumidity_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView_currentHumidity" />

        <TextView
            android:id="@+id/textView_currentHumidity_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Humidity"
            android:textColor="@color/font_alt"
            android:textSize="15sp"
            android:translationZ="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/textView_currentHumidity_1"
            app:layout_constraintStart_toStartOf="@+id/textView_currentHumidity_1" />

        <ImageView
            android:id="@+id/imageView_currentVisibility"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:contentDescription="TODO"
            android:scaleType="fitXY"
            android:src="@mipmap/icon_visibility_foreground"
            app:layout_constraintBottom_toBottomOf="@+id/imageView_currentHumidity"
            app:layout_constraintEnd_toEndOf="@+id/textView_currentVisibility_1"
            app:layout_constraintStart_toStartOf="@+id/textView_currentVisibility_1"
            app:layout_constraintTop_toTopOf="@+id/imageView_currentHumidity" />

        <TextView
            android:id="@+id/textView_currentVisibility_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:text="10 mi"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:translationZ="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/textView_currentHumidity_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/textView_currentHumidity_1"
            app:layout_constraintTop_toTopOf="@+id/textView_currentHumidity_1" />

        <TextView
            android:id="@+id/textView_currentVisibility_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:text="Visibility"
            android:textColor="@color/font_alt"
            android:textSize="15sp"
            android:translationZ="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/textView_currentHumidity_2"
            app:layout_constraintEnd_toEndOf="@+id/textView_currentVisibility_1"
            app:layout_constraintStart_toStartOf="@+id/textView_currentVisibility_1"
            app:layout_constraintTop_toTopOf="@+id/textView_currentHumidity_2" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/textView_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Today"
        android:textColor="@color/font"
        android:textSize="24sp"
        android:translationZ="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView" />

    <TextView
        android:id="@+id/textView_sevenDays"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:text="7 days >"
        android:textColor="@color/font_alt"
        android:textSize="20sp"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/textView_today"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textView_today" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listView_hourlyWeather"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:nestedScrollingEnabled="false"
        android:orientation="horizontal"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_today" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listView_dailyWeather"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:translationZ="10dp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView" />


    <TextView
        android:id="@+id/textView_tomorrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tomorrow"
        android:textColor="@color/font"
        android:textSize="25sp"
        app:layout_constraintLeft_toRightOf="@id/imageView_weatherIcon"
        app:layout_constraintTop_toTopOf="@id/imageView_weatherIcon"
        android:translationZ="10dp"
        android:visibility="invisible"
        />



</androidx.constraintlayout.motion.widget.MotionLayout>