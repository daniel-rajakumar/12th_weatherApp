<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/motionLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:translationZ="10dp"
    app:layoutDescription="@xml/activity_main_scene"
    tools:context=".MainActivity">


    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.80"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="-75dp"
            app:cardBackgroundColor="@color/dark_blue"
            app:cardCornerRadius="75dp">

            <ImageView
                android:id="@+id/imageVIew_backgroundGif"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="TODO"
                android:scaleType="fitXY" />

        </androidx.cardview.widget.CardView>
    </androidx.cardview.widget.CardView>

    <EditText
        android:id="@+id/editText_ZipCode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="numberDecimal"
        android:text="76629"
        android:layout_marginStart="30dp"
        android:textColor="@color/font"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/button_search"
        app:layout_constraintEnd_toStartOf="@+id/button_search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/button_search" />

    <Button
        android:id="@+id/button_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null"
        android:backgroundTint="@color/dark_blue"
        android:text="Search"
        android:translationZ="10dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.04" />

    <TextView
        android:id="@+id/textView_cityName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/ubuntu_light"
        android:singleLine="true"
        android:text="New York"
        android:textAlignment="center"
        android:textColor="@color/font"
        android:textSize="35sp"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.12"
        app:layout_constraintWidth_percent="1" />

    <TextView
        android:id="@+id/textView_lat_lon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ubuntu_light"
        android:text="(lat, lon)"
        android:textColor="@color/font_alt"
        android:textSize="20sp"
        android:textStyle="bold"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.17000002" />

    <ImageView
        android:id="@+id/imageView_weatherIcon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="TODO"
        android:src="@drawable/icon_rain"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.26" />

    <TextView
        android:id="@+id/textView_currentTemp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ubuntu_light"
        android:text="-0.63°"
        android:textColor="@color/white"
        android:textSize="66sp"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45" />

    <TextView
        android:id="@+id/textView_weatherDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ubuntu_light"
        android:text="rain"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.53" />

    <TextView
        android:id="@+id/textView_currentDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ubuntu_light"
        android:text="Monday, 17 May"
        android:textColor="@color/font_alt"
        android:textSize="20sp"
        android:textStyle="bold"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.59000003" />

    <View
        android:id="@+id/view_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="35dp"
        android:background="@color/font_alt"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.002"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.63" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.15"
        app:layout_constraintWidth_percent="1"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/cardView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <ImageView
            android:id="@+id/imageView_currentWind"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="TODO"
            android:scaleType="fitXY"
            android:src="@mipmap/icon_wind_foreground"
            app:layout_constraintBottom_toBottomOf="@+id/imageView_currentHumidity"
            app:layout_constraintEnd_toEndOf="@+id/textView_currentWindSpeed_2"
            app:layout_constraintStart_toStartOf="@+id/textView_currentWindSpeed_2"
            app:layout_constraintTop_toTopOf="@+id/imageView_currentHumidity" />

        <TextView
            android:id="@+id/textView_currentWindSpeed_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/ubuntu_light"
            android:text="13 km/h"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:translationZ="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/textView_currentHumidity_1"
            app:layout_constraintEnd_toEndOf="@+id/textView_currentWindSpeed_2"
            app:layout_constraintStart_toStartOf="@+id/textView_currentWindSpeed_2"
            app:layout_constraintTop_toTopOf="@+id/textView_currentHumidity_1" />

        <TextView
            android:id="@+id/textView_currentWindSpeed_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/ubuntu_light"
            android:text="Wind"
            android:textColor="@color/font_alt"
            android:textSize="15sp"
            android:textStyle="bold"
            android:translationZ="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/textView_currentHumidity_2"
            app:layout_constraintEnd_toStartOf="@+id/textView_currentHumidity_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textView_currentHumidity_2" />

        <ImageView
            android:id="@+id/imageView_currentHumidity"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="TODO"
            android:scaleType="fitXY"
            android:src="@mipmap/icon_humidity_foreground"
            app:layout_constraintEnd_toEndOf="@+id/textView_currentHumidity_2"
            app:layout_constraintStart_toStartOf="@+id/textView_currentHumidity_2"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView_currentHumidity_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/ubuntu_light"
            android:text="24%"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:translationZ="20dp"
            app:layout_constraintBottom_toTopOf="@+id/textView_currentHumidity_2"
            app:layout_constraintEnd_toEndOf="@+id/textView_currentHumidity_2"
            app:layout_constraintStart_toStartOf="@+id/textView_currentHumidity_2"
            app:layout_constraintTop_toBottomOf="@+id/imageView_currentHumidity" />

        <TextView
            android:id="@+id/textView_currentHumidity_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/ubuntu_light"
            android:text="Humidity"
            android:textColor="@color/font_alt"
            android:textSize="15sp"
            android:textStyle="bold"
            android:translationZ="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/imageView_currentFeelsLike"
            android:layout_width="80dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:contentDescription="TODO"
            android:scaleType="fitXY"
            android:src="@mipmap/icon_feels_like_foreground"
            app:layout_constraintBottom_toBottomOf="@+id/imageView_currentHumidity"
            app:layout_constraintEnd_toEndOf="@+id/textView_currentFeelsLike_2"
            app:layout_constraintStart_toStartOf="@+id/textView_currentFeelsLike_2"
            app:layout_constraintTop_toTopOf="@+id/imageView_currentHumidity" />

        <TextView
            android:id="@+id/textView_currentFeelsLike_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:fontFamily="@font/ubuntu_light"
            android:text="40%"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:translationZ="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/textView_currentHumidity_1"
            app:layout_constraintEnd_toEndOf="@+id/textView_currentFeelsLike_2"
            app:layout_constraintStart_toStartOf="@+id/textView_currentFeelsLike_2"
            app:layout_constraintTop_toTopOf="@+id/textView_currentHumidity_1" />

        <TextView
            android:id="@+id/textView_currentFeelsLike_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:fontFamily="@font/ubuntu_light"
            android:text="Feels like"
            android:textColor="@color/font_alt"
            android:textSize="15sp"
            android:textStyle="bold"
            android:translationZ="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/textView_currentHumidity_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/textView_currentHumidity_2"
            app:layout_constraintTop_toTopOf="@+id/textView_currentHumidity_2" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/textView_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="@font/ubuntu_light"
        android:text="Today"
        android:textColor="@color/font"
        android:textSize="24sp"
        android:translationZ="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView" />

    <TextView
        android:id="@+id/textView_sevenDays"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/ubuntu_light"
        android:text="7 days >"
        android:textColor="@color/font_alt"
        android:textSize="20sp"
        android:translationZ="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listView_hourlyWeather"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:nestedScrollingEnabled="false"
        android:orientation="horizontal"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_today" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listView_dailyWeather"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:orientation="vertical"
        android:paddingTop="15dp"
        android:translationZ="10dp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView" />


    <TextView
        android:id="@+id/textView_tomorrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ubuntu_light"
        android:text="Tomorrow"
        android:textColor="@color/font"
        android:textSize="25sp"
        android:translationZ="10dp"
        android:visibility="invisible"
        app:layout_constraintLeft_toRightOf="@id/imageView_weatherIcon"
        app:layout_constraintTop_toTopOf="@id/imageView_weatherIcon" />


    <TextView
        android:id="@+id/textView_tomorrowTempMin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="23.4"
        android:textColor="@color/font_alt"
        android:textSize="25sp"
        android:translationZ="10dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/textView_currentTemp"
        app:layout_constraintLeft_toRightOf="@id/textView_currentTemp" />


</androidx.constraintlayout.widget.ConstraintLayout>